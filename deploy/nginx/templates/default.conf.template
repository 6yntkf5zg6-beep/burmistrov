# Конфиг веб-сервера «СТАН».
#
# Это шаблон: при старте контейнера nginx подставит сюда значения переменных окружения
# (у нас — DOMAIN) и положит результат в /etc/nginx/conf.d/default.conf. Подставляются
# только объявленные переменные, поэтому внутренние $host, $uri и прочие остаются как есть.

# ------------------------------------------------------------------- HTTP
# Единственная работа этого сервера — отдать проверку Let's Encrypt и увести всех на HTTPS.
server {
    listen 80;
    listen [::]:80;
    server_name ${DOMAIN};

    # Проверочный файл certbot кладёт на общий том, и он должен отдаваться по HTTP:
    # до выпуска сертификата HTTPS ещё нет.
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# ------------------------------------------------------------------ HTTPS
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name ${DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;

    # Настройки TLS выписаны здесь, а не подключены файлом от certbot: одним
    # скачиваемым файлом меньше, и видно, что именно включено.
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    # Год на HSTS говорит браузеру ходить сюда только по HTTPS, даже если пользователь
    # наберёт адрес руками.
    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    # Совпадает с ограничением Spring на размер файла: иначе видео упражнения упрётся
    # в nginx и тренер увидит непонятную ошибку 413 вместо внятного ответа сервера.
    client_max_body_size 25m;

    root /usr/share/nginx/html;
    index index.html;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;
    gzip_min_length 1024;

    # ----- бэкенд
    location /api/ {
        proxy_pass http://app:8080;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Загрузка видео с телефона по слабой связи занимает минуты — стандартной
        # минуты ожидания не хватает.
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }

    # ----- фото и видео упражнений (их отдаёт бэкенд с примонтированного тома)
    location /uploads/ {
        proxy_pass http://app:8080;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 300s;
    }

    # ----- статика фронтенда
    # Vite добавляет в имена файлов хеш содержимого, поэтому их можно кэшировать
    # навсегда: изменился файл — изменилось имя.
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    # Адреса вроде /dashboard/workouts/12 существуют только внутри React Router.
    # На сервере такого файла нет, поэтому любой неизвестный путь отдаёт index.html,
    # а дальше маршрут разбирает уже приложение. Без этой строки обновление страницы
    # в браузере давало бы 404.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
