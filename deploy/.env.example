# Настройки боевого стенда «СТАН». Скопируйте в .env и заполните.
#   cp .env.example .env && nano .env
# Файл .env содержит пароли — в git его класть нельзя.

# ---------------------------------------------------------------- домен
# Домен без https:// и без слэша. A-запись должна указывать на IP сервера.
DOMAIN=stan.example.ru
# Почта для Let's Encrypt: на неё придёт письмо, если сертификат вдруг не продлится.
CERTBOT_EMAIL=you@example.ru

# ----------------------------------------------------------------- база
DB_NAME=burmistrov
DB_USER=burmistrov
# Придумайте свой:  openssl rand -base64 24
DB_PASSWORD=ЗАМЕНИТЕ_МЕНЯ

# ------------------------------------------------------------------ JWT
# Ключ подписи токенов входа. Кто его знает — может войти под любым пользователем.
# Сгенерируйте:  openssl rand -base64 48
JWT_SECRET=ЗАМЕНИТЕ_МЕНЯ
# Сколько живёт токен доступа (15 минут) и токен продления (30 дней), в миллисекундах.
JWT_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=2592000000

# ------------------------------------------------- первый вход тренера
# При первом запуске на пустой базе заводится эта учётная запись.
# Пароль смените сразу после входа.
SEED_TRAINER_EMAIL=trainer@burmistrov.pro
SEED_TRAINER_PASSWORD=ЗАМЕНИТЕ_МЕНЯ

# -------------------------------------------------------------- прочее
# Часовой пояс зала: по нему сервер решает, наступил ли день тренировки.
GYM_TIMEZONE=Europe/Moscow
# Сколько тренировка доступна клиенту после открытия (формат ISO-8601).
WORKOUT_ACCESS_DURATION=PT3H

# ------------------------------------------------------- пути к исходникам
# Где лежат репозитории относительно этой папки. Если склонировать их рядом,
# как в инструкции, менять ничего не нужно.
BACKEND_PATH=..
UI_PATH=../../burmistrov-ui

# ------------------------------------------------- потолки памяти
# Рассчитаны на сервер с 2 ГБ: в сумме около 1.3 ГБ, остальное остаётся системе.
# Расширите машину — поднимите и эти значения.
DB_MEM_LIMIT=384m
APP_MEM_LIMIT=768m
WEB_MEM_LIMIT=128m
